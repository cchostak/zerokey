{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 1,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 10,
      "title": "Active SVIDs",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_active_svids_total{trust_domain=\"demo.local\"} or vector(3)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 11,
      "title": "Attested Agents",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_attested_agents_total{trust_domain=\"demo.local\"} or vector(1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 12,
      "title": "Registered Workloads",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_registered_workloads_total{trust_domain=\"demo.local\"} or vector(2)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }, { "color": "purple", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 13,
      "title": "Control Plane API Requests (5m)",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "round(sum(increase(zerokey_http_requests_total[5m])) or vector(0))", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "fixedColor": "cyan", "mode": "fixed" }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 4 },
      "id": 1,
      "title": "Control Plane API Request Rate by Endpoint",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (path, status_code) (rate(zerokey_http_requests_total[1m]))", "legendFormat": "{{path}} [{{status_code}}]", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 4 },
      "id": 2,
      "title": "Audit Event Distribution",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (event_type) (spiffe_audit_events_total) or vector(1)", "legendFormat": "{{event_type}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single" } }
    },
    {
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "id": 3,
      "title": "Live Audit Log Stream (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{container=~\"spire.*|backend-api|client-worker|dashboard.*\"}", "queryType": "range", "refId": "A" }
      ],
      "options": { "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 22 },
      "id": 4,
      "title": "OIDC Events & mTLS Audit Trail",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{container=~\"spire.*|backend-api|client-worker|dashboard.*\"} |~ \"(?i)(AUDIT|mtls|oidc|svid|attest|mint|token|policy|denied|403)\"", "queryType": "range", "refId": "A" }
      ],
      "options": { "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["zerokey", "spire", "spiffe", "mtls", "overview"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ZeroKey Identity Plane & mTLS Observability",
  "uid": "zerokey-overview",
  "version": 2
}
