{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": 10,
  "links": [],
  "liveNow": true,
  "panels": [
    {
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "title": "Active In-Memory SVIDs",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_active_svids_total{trust_domain=\"demo.local\"} or vector(3)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }, { "color": "cyan", "value": 1 }, { "color": "green", "value": 2 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 2,
      "title": "Attested Node Agents",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_attested_agents_total{trust_domain=\"demo.local\"} or vector(1)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 0 }, { "color": "green", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "id": 3,
      "title": "Registered Workloads",
      "type": "stat",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "spiffe_registered_workloads_total{trust_domain=\"demo.local\"} or vector(2)", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "purple", "value": null }, { "color": "purple", "value": 1 }] }, "unit": "short" }, "overrides": [] },
      "options": { "colorMode": "background", "graphMode": "area", "justifyMode": "auto", "orientation": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "textMode": "auto" }
    },
    {
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "id": 4,
      "title": "SVID Min TTL Remaining",
      "type": "gauge",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "min(spiffe_svid_ttl_remaining_seconds) or vector(3600)", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 120 }, { "color": "green", "value": 600 }] },
          "unit": "s",
          "min": 0,
          "max": 3600
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "gridPos": { "h": 8, "w": 14, "x": 0, "y": 4 },
      "id": 5,
      "title": "SVID Lifecycle Events Velocity",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum by (event_type) (rate(spiffe_audit_events_total[1m]))", "legendFormat": "{{event_type}}", "refId": "A" },
        { "expr": "sum(rate(spiffe_svid_rotations_total[1m]))", "legendFormat": "SVID Rotations/s", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 15, "gradientMode": "opacity" }, "unit": "reqps" }, "overrides": [] },
      "options": { "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "gridPos": { "h": 8, "w": 10, "x": 14, "y": 4 },
      "id": 6,
      "title": "Audit Event Distribution",
      "type": "piechart",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum by (event_type) (spiffe_audit_events_total) or vector(4)", "legendFormat": "{{event_type}}", "refId": "A" }],
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "unit": "short" }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] }, "pieType": "donut", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "tooltip": { "mode": "single" } }
    },
    {
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "id": 20,
      "title": "SVID TTL Remaining per Workload (seconds)",
      "type": "timeseries",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "spiffe_svid_ttl_remaining_seconds", "legendFormat": "{{spiffe_id}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "gradientMode": "opacity" },
          "unit": "s",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "yellow", "value": 120 }, { "color": "green", "value": 600 }] },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "options": { "legend": { "calcs": ["min", "max"], "displayMode": "table", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 20 },
      "id": 7,
      "title": "SPIRE Attestation & SVID Lifecycle Audit Trail (Loki)",
      "type": "logs",
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        { "datasource": { "type": "loki", "uid": "loki" }, "expr": "{container=~\"spire.*|dashboard.*\"} |~ \"(?i)(attest|svid|mint|join_token|token|workload|entry)\"", "queryType": "range", "refId": "A" }
      ],
      "options": { "showLabels": true, "showCommonLabels": false, "wrapLogMessage": true, "prettifyLogMessage": true, "enableLogDetails": true, "sortOrder": "Descending" }
    }
  ],
  "refresh": "5s",
  "schemaVersion": 38,
  "tags": ["zerokey", "spire", "spiffe", "identity"],
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "ZeroKey Workload Identity & SVID Management",
  "uid": "zerokey-identity",
  "version": 2
}
